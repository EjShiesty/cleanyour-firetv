<?xml version="1.0" encoding="utf-8"?>
<!-- Full-card art for YouTube TV. Its installed app exposes a tiny square icon and no TV banner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFE62117" android:endColor="#FFB00016" />
        </shape>
    </item>
    <item android:width="124dp" android:height="124dp" android:gravity="center"
        android:drawable="@drawable/ic_youtube_tv_play" />
</layer-list>
